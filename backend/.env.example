# 后端配置示例（复制为 .env 后填入真实值；示例凭据仅用于本地开发）
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://schedule_dev:schedule_dev@127.0.0.1:5432/schedule_dev

# 导入原始文件与本人头像的私有目录；留空时使用 backend/var/media，不要配置公开 URL
# DJANGO_MEDIA_ROOT=/srv/teacher-schedule/private-media

# 本地邮件：Mailpit（SMTP 1025；Web/API 8025）
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL="教师课程表 <noreply@example.invalid>"

# 邮件中的 App 深链前缀；示例为自定义 scheme，正式环境可改为
# https://<域名>/app（不要带查询参数）
APP_LINK_BASE=teacherschedule://

# 教学计划落后阈值（Decimal 字符串，默认 2.0 学时；不要使用浮点数）
PLAN_BEHIND_THRESHOLD_HOURS=2.0
