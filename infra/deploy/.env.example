# ---------------------------------------------------------------------------
# infra/deploy/.env.example —— 部署演练示例（复制为 .env 后修改）
# ---------------------------------------------------------------------------
# 所有 change-me 值都是无效示例；不要提交真实 .env（仓库 .gitignore 已忽略）。
# 生成 Django 密钥（PowerShell）：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
# 数据库密码写进 DATABASE_URL 前需百分号编码，建议只用字母数字。
# ---------------------------------------------------------------------------

# API 镜像名与发布端口；默认只监听本机回环地址。
API_IMAGE=teacher-schedule-api:local
API_BIND_ADDRESS=127.0.0.1
API_PORT=18000

# 必填：Django 密钥与数据库密码（示例值无效，必须替换）。
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
POSTGRES_PASSWORD=change-me-to-a-strong-db-password

# 数据库名/用户。改密码请同时改上面的 POSTGRES_PASSWORD。
POSTGRES_DB=schedule_app
POSTGRES_USER=schedule_app

# 允许的 Host，逗号分隔；反向代理场景填实际域名。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 邮件：不填 EMAIL_HOST 也能启动，但发送邮件会失败；接入真实 SMTP 后填写。
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="教师课程表 <noreply@example.invalid>"

# 邮件中的 App 深链前缀；正式环境可改为 https://<域名>/app
APP_LINK_BASE=teacherschedule://
